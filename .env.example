# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AAH_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database connection URL (PostgreSQL or SQLite examples)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/barbershop_db
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_DB=barbershop_db

# JSON-formatted list of Telegram user IDs of administrators
ADMIN_IDS=[123456789, 987654321]

# Telegram chat/group ID for managers (supergroups start with -100)
MANAGER_CHAT_ID=-1001234567890

# Telegram chat/group ID for system alerts / power status / error logs
ALERT_CHAT_ID=-1009876543210

# Timezone in IANA format
TIMEZONE=Europe/Kyiv

# Cashback percentage earned per visit (0-100)
CASHBACK_PERCENT=5

# Delay before sending a review request after a visit (in minutes, >= 0)
REVIEW_DELAY_MIN=90

# Discount percentage for last-minute ("hot") booking slots (0-100)
HOT_WINDOW_DISCOUNT_PERCENT=10